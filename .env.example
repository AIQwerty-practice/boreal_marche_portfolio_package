# Copy to .env for local development. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=INFO
BOREAL_API_TOKEN=
BOREAL_TOOL_API_BASE_URL=

# Hosted chat provider (leave blank to disable; never commit a real key).
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=
HOSTED_LLM_INPUT_COST_PER_MILLION=
HOSTED_LLM_OUTPUT_COST_PER_MILLION=

# Optional local Ollama routing for the customer assistant. Keep values private.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_BEARER_TOKEN=

# Required only to expose an enabled LLM choice in the browser. This is a local
# demo access token, not an Ollama, OpenAI, or internal tool credential.
BOREAL_LLM_ACCESS_TOKEN=

# Optional local staff-demo sign-in. Use a unique local password; never commit it.
BOREAL_DEMO_STAFF_USERNAME=staff-demo
BOREAL_DEMO_STAFF_PASSWORD=
