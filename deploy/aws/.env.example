# Copy this file to deploy/aws/.env on the EC2 instance. Never commit .env.
BOREAL_IMAGE_TAG=replace_with_verified_commit_sha
LOG_LEVEL=INFO
BOREAL_ERROR_RATE_ALERT_THRESHOLD=0.20
# Synthetic, bounded drift comparison only; keep off on public deployments.
BOREAL_ENABLE_DRIFT_DEMO=0
HOST_UID=1000
HOST_GID=1000

# Generate a long random value on the server; never paste it into screenshots.
BOREAL_API_TOKEN=replace_on_server

# Restricted course-demo staff sign-in; leave password blank until set privately on the server.
BOREAL_DEMO_STAFF_USERNAME=staff-demo
BOREAL_DEMO_STAFF_PASSWORD=

# Set a verified immutable image tag or digest before deployment; never use latest.
OLLAMA_IMAGE_TAG=replace_with_verified_tag_or_digest
OLLAMA_MODEL=qwen3:4b

# Optional hosted-provider comparison. Leave blank until credentials are configured.
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=
HOSTED_LLM_INPUT_COST_PER_MILLION=
HOSTED_LLM_OUTPUT_COST_PER_MILLION=

# Optional live Head C OpenAI routing. Keep the API key only in a private .env or secret store.
# Explicit enablement prevents accidental external calls and charges.
BOREAL_ENABLE_OPENAI=0
# Separate from BOREAL_API_TOKEN; required for either LLM choice in the browser.
BOREAL_LLM_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

# Optional Hugging Face Inference Providers routing. Select and validate an exact
# chat-completion model/provider before enabling; HF_TOKEN needs inference permission.
BOREAL_ENABLE_HUGGINGFACE=0
HF_TOKEN=
HF_MODEL=
HF_INPUT_COST_PER_MILLION=
HF_OUTPUT_COST_PER_MILLION=

# Add only after the DNS record points to this Canada Central instance.
BOREAL_DOMAIN=boreal.example.com
