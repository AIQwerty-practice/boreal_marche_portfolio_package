{
  "region": "ca-central-1",
  "bucket": "YOUR_PRIVATE_BUCKET",
  "role_arn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/BorealMarcheSageMakerExecutionRole",
  "input_key": "d3/input/customer_snapshots_development.parquet",
  "output_prefix": "d3/output",
  "code_prefix": "d3/source",
  "instance_type": "ml.m5.large",
  "framework_version": "1.2-1",
  "python_version": "py3",
  "max_jobs": 8,
  "max_parallel_jobs": 2,
  "max_run_seconds": 900,
  "max_wait_seconds": 1200,
  "random_seed": 42,
  "base_job_name": "boreal-d3-rf-hpo",
  "managed_spot": true
}
